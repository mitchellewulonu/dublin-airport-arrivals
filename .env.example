PORT=3040

# MPP challenge-signing secret (openssl rand -hex 32)
MPP_SECRET_KEY=

# Tempo crypto deposit address (Stripe sandbox/live)
TEMPO_DEPOSIT_ADDRESS=0x...

# true = Tempo Moderato testnet; false = Tempo mainnet
TEMPO_TESTNET=true

# USD amount charged per paid request
MPP_PRICE=0.01

# Optional: Stripe key for PaymentIntent recording / x402 helpers
STRIPE_SECRET_KEY=sk_test_...
DEPOSIT_ADDRESS=0x...
X402_NETWORK=testnet
X402_PRICE=$0.01
